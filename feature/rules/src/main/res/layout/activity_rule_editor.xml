<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/rule_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rule_editor_intro"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/rule_enabled"
            android:tag="rule_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/rule_editor_enabled" />

        <Switch
            android:id="@+id/rule_block_all"
            android:tag="rule_block_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rule_editor_block_all" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rule_editor_daily_limit_heading"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rule_editor_daily_limit_hint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/rule_daily_limit"
            android:tag="rule_daily_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rule_editor_daily_limit_placeholder"
            android:inputType="number"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/rule_daily_limit_clear"
            android:tag="rule_daily_limit_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rule_editor_daily_limit_clear" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rule_editor_schedules_heading"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rule_no_schedules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rule_editor_no_schedules"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/rule_schedules_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/rule_error"
            android:tag="rule_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#B00020"
            android:textSize="15sp" />

        <Button
            android:id="@+id/rule_save"
            android:tag="rule_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/rule_editor_save" />

        <Button
            android:id="@+id/rule_delete"
            android:tag="rule_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rule_editor_delete" />

    </LinearLayout>
</ScrollView>
