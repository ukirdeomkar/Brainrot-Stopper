    <string name="app_picker_add_selected">Add selected apps</string>
    <string name="app_picker_none_selected">Select at least one app first.</string>

    <string name="rule_editor_title">Edit app rule</string>
    <string name="rule_editor_intro">Turn on always-block to block the whole app at all times, or use schedules and a daily limit instead. A schedule disables itself while it is switched off.</string>
    <string name="rule_editor_enabled">Guard this app</string>
    <string name="rule_editor_block_all">Always block this app (whole app)</string>
    <string name="rule_editor_daily_limit_heading">Daily limit</string>
    <string name="rule_editor_daily_limit_hint">Minutes per day the app may be used. Leave empty for no limit; timers stay off for this app.</string>
    <string name="rule_editor_daily_limit_placeholder">e.g. 30</string>
    <string name="rule_editor_daily_limit_clear">Clear limit</string>
    <string name="rule_editor_daily_limit_error_number">Enter the daily limit as a whole number of minutes.</string>
    <string name="rule_editor_daily_limit_error_positive">Daily limit must be at least 1 minute. Leave empty for no limit.</string>
    <string name="rule_editor_daily_limit_error_too_large">Daily limit must be %1$d minutes (24 hours) or less.</string>
