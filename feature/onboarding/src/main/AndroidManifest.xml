<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Usage Access is a protected permission: only the user can grant it in Settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 13+ runtime permission for the foreground-service status notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery-optimization exemption is requested through a Settings screen. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <activity
            android:name="dev.brainrotstopper.feature.onboarding.OnboardingActivity"
            android:exported="false" />
    </application>

</manifest>
